# Copy to .env and fill keys for stocks/forex data providers
VITE_ALPHA_VANTAGE_KEY=YOUR_ALPHA_VANTAGE_KEY
# Optional — Finnhub forex requires a paid plan; Dukascopy is used by default (free)
FINNHUB_API_KEY=YOUR_FINNHUB_API_KEY

# Pepperstone gold/metals via cTrader Open API (matches your Pepperstone chart prices)
# 1. Create app: https://openapi.ctrader.com/apps
# 2. Connect your Pepperstone cTrader account (demo or live)
# 3. Run: npx ctrader-ts auth   OR paste tokens below
CTRADER_CLIENT_ID=your_client_id
CTRADER_CLIENT_SECRET=your_client_secret
CTRADER_ACCESS_TOKEN=your_access_token
CTRADER_REFRESH_TOKEN=your_refresh_token
CTRADER_ACCOUNT_ID=12345678
CTRADER_ENVIRONMENT=demo
